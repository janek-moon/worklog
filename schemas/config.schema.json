{
  "title": "worklog config",
  "type": "object",
  "properties": {
    "output": {
      "type": "object",
      "properties": {
        "dir": { "type": "string" },
        "htmlMirror": { "type": "boolean", "default": true }
      }
    },
    "sources": {
      "type": "object",
      "properties": {
        "git": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "repos": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        },
        "plan": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "paths": { "type": "array", "items": { "type": "string" }, "default": ["PLAN.md", "SPEC.md"] }
          }
        }
      }
    },
    "learnings": {
      "type": "object",
      "properties": {
        "extraction": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "maxCandidates": { "type": "integer", "minimum": 0, "default": 5 }
          }
        },
        "apply": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string" },
                  "section": { "type": ["string", "null"], "default": null },
                  "ifAbsent": { "type": "string", "enum": ["skip", "create", "error"], "default": "skip" }
                }
              }
            },
            "requireApproval": { "type": "boolean", "default": true },
            "dryRun": { "type": "boolean", "default": false },
            "backupSuffix": { "type": "string", "default": ".bak" }
          }
        }
      }
    },
    "framework": { "type": "string", "enum": ["KPT"], "default": "KPT" },
    "language": { "type": "string", "enum": ["auto", "ko", "en"], "default": "auto" },
    "tz": { "type": ["string", "null"], "default": null },
    "pii": {
      "type": "object",
      "properties": {
        "allowedEmails": { "type": "array", "items": { "type": "string" } },
        "customPatterns": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
